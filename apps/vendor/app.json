{
  "expo": {
    "name": "KMCP Vendor",
    "slug": "kmcp-vendor",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kmcpvendor",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.gov.kmc.parking.vendor"
    },
    "android": {
      "package": "in.gov.kmc.parking.vendor",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "KMCP needs the camera to photograph the number plate. That photograph is the evidence behind the fare."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "KMCP checks you are standing in the zone before a session can be started there."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

# Copy to .env.local to point this app at a locally-running kmcp-backend
# instead of the hosted one in .env. Expo loads .env.local with HIGHER
# priority than .env, and .env.local is gitignored, so this never leaks into
# a commit and never has to touch the checked-in .env.
#
# Easier than editing this by hand: `npm run dev:local` (from this
# directory, or the workspace root) auto-detects this machine's LAN IP and
# starts Expo with EXPO_PUBLIC_API_URL already set — most of the time you
# don't need this file at all. Use this file instead when you want the
# override to persist across every `npm run start`/`expo start`, or when
# auto-detection picks the wrong network interface.
#
# What to put here depends on where the app is running:
#
#   Physical device, Expo Go — this machine's LAN IP (not "localhost", which
#   on the phone means the phone itself). Find it with:
#     macOS:   ipconfig getifaddr en0
#     Linux:   hostname -I
#     Windows: ipconfig            (look for "IPv4 Address")
#   EXPO_PUBLIC_API_URL=http://192.168.1.23:4000/api/v1
#
#   iOS Simulator (same machine as the backend) — localhost works directly:
#   EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
#
#   Android Emulator — 10.0.2.2 is the emulator's alias for the host machine:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
#
# Either way, kmcp-backend must actually be running (`npm run dev` in that
# repo) on the port referenced above (default 4000, see PORT in its .env).
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
